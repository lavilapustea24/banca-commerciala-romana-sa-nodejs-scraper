{
  "name": "banca-commerciala-romana-sa-nodejs-scraper",
  "version": "1.0.0",
  "description": "Web scraper pentru a aduce locurile de muncă de la BCR în platforma peviitor.ro",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "scrape": "node index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=tests/unit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest tests/e2e"
  },
  "keywords": ["scraper", "jobs", "bcr", "peviitor", "nodejs"],
  "author": "lavilapustea24",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
